{
  "name": "react-native-pixelkit",
  "version": "0.1.0",
  "description": "A simple pixel UI library using svg componentsUI library using react-native-svg",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-pixelkit-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-pixelkit-example start",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "lint": "yarn lint:packagejson && yarn tsc && yarn _prettier --check && yarn lint:ox",
    "lint:packagejson": "node scripts/validatePackagejson.js",
    "lint:ox": "oxlint .",
    "test": "jest",
    "_prettier": "prettier 'scripts/**/*.js' '{__tests__,src}/**/*.{js,ts,tsx,scss,css,json}' --config .prettierrc",
    "format": "yarn _prettier --write",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vahn-gh/react-native-pixelkit.git"
  },
  "author": "vahn-gh <wah4nya@gmail.com> (https://github.com/vahn-gh)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vahn-gh/react-native-pixelkit/issues"
  },
  "homepage": "https://github.com/vahn-gh/react-native-pixelkit#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.0",
    "@jest/globals": "29.7.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@release-it/conventional-changelog": "12.0.0",
    "@shopify/react-native-skia": "2.12.0",
    "@types/react": "19.2.0",
    "commitlint": "21.2.1",
    "del-cli": "7.0.0",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-standard": "5.0.0",
    "jest": "29.7.0",
    "lefthook": "2.1.10",
    "oxlint": "1.85.0",
    "prettier": "3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "0.43.0",
    "release-it": "21.0.1",
    "turbo": "2.10.8",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "2.12.0",
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "<%- project.sourceCondition -%>"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.63.1"
  }
}
